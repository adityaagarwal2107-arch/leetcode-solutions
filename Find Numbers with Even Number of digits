class Solution {
    public int findNumbers(int[] nums) {
         int evenDigit=0;
        for(int i=0;i<=nums.length-1;i++){
            int count=0;
            while(nums[i]!=0){
                nums[i]/=10;
                count++;
            }
            if(count%2==0){
                evenDigit++;
            }
                }
                return evenDigit;
    }
}
